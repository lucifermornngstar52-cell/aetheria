; Engine configuration file.
; Aetheria - Lumenhold: procedural anime-MMORPG open world (Godot 4.2+)

config_version=5

[application]

config/name="Aetheria - Lumenhold"
config/description="Large open world for a mobile anime MMORPG: capital city, castle, forests, rivers, lakes, villages, dungeons."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[importer_defaults]

scene={
"meshes/create_shadow_meshes": false,
"meshes/ensure_tangents": false,
"meshes/generate_lods": false,
"meshes/light_baking": 0
}
texture={
"compress/mode": 2,
"mipmaps/generate": true
}

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
occlusion_culling/use_occlusion_culling=true
environment/defaults/default_clear_color=Color(0.6, 0.75, 0.95, 1)
